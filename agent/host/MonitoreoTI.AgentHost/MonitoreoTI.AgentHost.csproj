<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    Anfitrión del servicio de Windows del agente: Windows lo controla (iniciar, detener, reiniciar si falla)
    y él lanza y vigila el agente Electron en modo servicio. También instala y desinstala el servicio.
    Se publica autocontenido en un solo .exe: las PC no necesitan tener .NET instalado.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MonitoreoTI.AgentHost</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>
</Project>
