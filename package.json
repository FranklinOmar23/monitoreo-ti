{
  "name": "monitoreo-ti",
  "private": true,
  "workspaces": [
    "shared",
    "desktop",
    "mobile",
    "agent"
  ],
  "scripts": {
    "dev:desktop": "npm run dev -w @monitoreoti/desktop",
    "dev:agent": "npm run dev -w @monitoreoti/agent",
    "start:mobile": "npm run start -w @monitoreoti/mobile",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
